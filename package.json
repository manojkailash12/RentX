{
  "name": "rentx-netlify",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "netlify dev",
    "dev:frontend": "vite",
    "dev:socket": "node socket-server.js",
    "dev:cron": "node deletion-cron-service.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:socket\" \"npm run dev:cron\"",
    "dev:with-cron": "concurrently \"npm run dev\" \"npm run dev:cron\"",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "functions:serve": "netlify-lambda serve netlify/functions",
    "functions:build": "netlify-lambda build netlify/functions",
    "netlify:dev": "netlify dev",
    "deploy": "netlify deploy --prod",
    "start": "netlify dev",
    "cron": "node deletion-cron-service.js",
    "migrate:approve-cars": "node netlify/functions/utils/approveAllCars.js",
    "migrate:fix-review-indexes": "node netlify/functions/migrations/fix-review-indexes.js",
    "migrate:cleanup-collections": "node netlify/functions/migrations/cleanup-unused-collections.js",
    "migrate:analyze-collections": "node netlify/functions/migrations/analyze-collections.js",
    "migrate:delete-empty-collections": "node netlify/functions/migrations/delete-empty-collections.js",
    "migrate:delete-empty-auto": "node netlify/functions/migrations/delete-empty-collections-auto.js"
  },
